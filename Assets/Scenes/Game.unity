  m_text: "\u0423\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u0415\n\n\u041A\u043B\u0438\u043A
    \u043C\u044B\u0448\u044C\u044E  \u0438\u043B\u0438 \u043A\u0430\u0441\u0430\u043D\u0438\u0435
